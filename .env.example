# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=jewellery_shop

# Login credentials for the app (single shop login)
APP_USERNAME=admin
# Generate with: npm run hash-password
APP_PASSWORD_HASH=

# Any long random string — used to sign login sessions. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: pre-fill shop settings on first run (you can also just edit
# them in the app's Settings page after logging in — these are only used
# once, to seed the very first settings document if none exists yet).
SEED_SHOP_NAME=My Jewellery Shop
SEED_SHOP_ADDRESS=
SEED_SHOP_STATE=
SEED_SHOP_PHONE=
SEED_SHOP_EMAIL=
SEED_SHOP_GSTIN=
SEED_INVOICE_PREFIX=INV
SEED_INVOICE_FOOTER=Thank you for your business!
SEED_GOLD_RATE=0
SEED_SILVER_RATE=0

NODE_ENV=development
